{
  "name": "fardamento-bmg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply fardamento-bmg-dev --local",
    "db:migrate:prod": "wrangler d1 migrations apply fardamento-bmg --remote --env production",
    "db:backup:prod": "node scripts/backup-d1.mjs",
    "deploy": "npm run build && wrangler deploy --env production",
    "cf:types": "wrangler types"
  },
  "engines": {
    "node": ">=20"
  }
}